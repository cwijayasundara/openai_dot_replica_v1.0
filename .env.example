# Names only. Copy to .env and fill secrets locally. Never commit .env.
DOT_MODEL_PROVIDER=fireworks
DOT_FIREWORKS_API_KEY=
DOT_OPENAI_BASE_URL=
DOT_SUPERVISOR_MODEL=accounts/fireworks/models/glm-5p3
DOT_HEAVY_MODEL=accounts/fireworks/models/kimi-k3
DOT_FAST_MODEL=accounts/fireworks/models/glm-5p3-flash
DOT_DATABASE_URL=postgresql://dot:dot@localhost:55434/dot
DOT_OBJECT_ROOT=var/objects
DOT_SANDBOX_BACKEND=docker
DOT_SANDBOX_IMAGE=dot-sandbox
# Registered OpenShell gateway name, as used by SandboxClient.from_active_cluster.
DOT_OPENSHELL_GATEWAY=
DOT_SANDBOX_IDLE_S=600
DOT_MAX_MODEL_CALLS=40
DOT_JOB_WORKERS=2
# Schedules: ceilings when a pack schedule sets none, and the zone its crons are read in.
DOT_SCHEDULE_MAX_MODEL_CALLS=20
DOT_SCHEDULE_MAX_TOKENS=200000
DOT_SCHEDULE_TIMEZONE=UTC
DOT_REFLECTION_MAX_EPISODES=200
DOT_REFLECTION_MAX_EDITS=5
DOT_REPLAY_CITED=5
DOT_REPLAY_RANDOM=5
DOT_REPLAY_MAX_MODEL_CALLS=4
# Cloud Scheduler's OIDC token: the audience it is minted for and its service account email.
DOT_SCHEDULER_AUDIENCE=
DOT_SCHEDULER_INVOKER=
DOT_MODEL_TIMEOUT_S=120
DOT_SLACK_BOT_TOKEN=
DOT_SLACK_APP_TOKEN=
DOT_SLACK_SIGNING_SECRET=
DOT_SLACK_MODE=socket
DOT_PACK_APPROVERS={}
DOT_SMTP_CREDENTIAL=
DOT_SMTP_HOST=
DOT_SMTP_PORT=587
DOT_SMTP_USERNAME=
DOT_SMTP_SENDER=
DOT_TAVILY_API_KEY=
DOT_CREDENTIAL_BACKEND=env
# Handle -> environment name locally; Secret Manager version resource on GCP.
DOT_CREDENTIAL_BINDINGS={"cred:smtp":"DOT_SMTP_CREDENTIAL","cred:slack-bot":"DOT_SLACK_BOT_TOKEN"}
# Web identity: off (no web user), dev (one fixed user, DOT_ENV=local only) or iap.
DOT_ENV=local
DOT_WEB_AUTH=dev
DOT_WEB_DEV_USER=local
# IAP backend audience, e.g. /projects/<number>/global/backendServices/<id>.
DOT_IAP_AUDIENCE=
