FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.8.13 /uv /uvx /bin/

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /app
COPY pyproject.toml uv.lock /app/
COPY src /app/src
# The wheel force-includes the sandbox policies, so they must exist before the install.
COPY sandbox/policies /app/sandbox/policies
# Editable, so the code stays at /app/src and REPO_ROOT is /app: packs and
# config are read from the repository layout, as in development.
RUN uv sync --frozen --no-dev
COPY packs /app/packs
COPY config /app/config

RUN useradd --create-home --uid 1000 app
USER app
ENV PATH="/app/.venv/bin:$PATH"
EXPOSE 8000
CMD ["uvicorn", "dot.surfaces.api:app", "--host", "0.0.0.0", "--port", "8000"]
